# Copy thành .env (KHÔNG commit). Dùng cùng DATABASE_URL và OPENAI_API_KEY với Day 6.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
AGENT_MODEL=gpt-4o-mini
DAY6_TABLE=lab06_api_chunks
DAY6_STRATEGY=A
# Giá USD / 1 triệu token — kiểm tra lại bảng giá hiện hành của OpenAI
PRICE_EMBED_PER_1M=0.02
PRICE_INPUT_PER_1M=0.15
PRICE_OUTPUT_PER_1M=0.60
